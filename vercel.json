{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["hnd1"],
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/((?!static/).*)", "destination": "/api/index" }
  ],
  "crons": [
    { "path": "/api/cron/daily", "schedule": "30 16 * * *" }
  ]
}
