# CWA Open Data key. Server-side only.
CWA_API_KEY=

# Turso. Leave empty to use the local data/weather.db.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Shared with cron-job.org (and Vercel Cron), sent as "Authorization: Bearer <value>".
CRON_SECRET=

# Cesium ion browser token. Restrict its allowed URLs in the ion console.
CESIUM_ION_TOKEN=

# MOENV (環境部) open data key, free from data.moenv.gov.tw. Server-side only.
# Without it the air-quality layer shows Open-Meteo's model estimate instead.
MOENV_API_KEY=
